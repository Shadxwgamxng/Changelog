# HelferNet – Konfiguration. Am einfachsten erzeugt scripts/install.sh diese Datei als .env mit sicheren Zufallswerten.

# ── Server / Docker ──────────────────────────────────────────────
# Öffentliche Adresse (Domain), unter der HelferNet erreichbar ist. Caddy holt dafür automatisch ein HTTPS-Zertifikat.
HELFERNET_DOMAIN="helfernet.example.org"
# Öffentliche Basis-URL (für Links in E-Mails/Kalender) – muss zur Domain passen.
APP_URL="https://helfernet.example.org"
# Datenbank-Passwort (Docker legt die Datenbank damit an)
HELFERNET_DB_PASSWORD=""
# "caddy" = mitgelieferter HTTPS-Proxy. Leer lassen, wenn ein eigener Reverse-Proxy auf 127.0.0.1:3000 zeigt.
COMPOSE_PROFILES="caddy"
# Interner Port der App auf dem Server (nur 127.0.0.1)
HELFERNET_PORT="3000"

# Nur ohne Docker nötig (eigene PostgreSQL-Instanz, ab Version 14):
# DATABASE_URL="postgresql://helfernet:PASSWORT@localhost:5432/helfernet?schema=public"
# STORAGE_DIR="/var/lib/helfernet/storage"

# ── Sicherheit ───────────────────────────────────────────────────
# 32 Byte (Base64) – verschlüsselt Dokumente und 2FA-Geheimnisse. NIE ändern, wenn schon Daten vorhanden sind!
# Erzeugen: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Einrichtungs-Code für die Ersteinrichtung unter /setup (danach wirkungslos)
SETUP_TOKEN=""
# Geheimnis für den HTTP-Wartungslauf (POST /api/cron/maintenance, Header Authorization: Bearer …)
CRON_SECRET=""

# Sitzungen
SESSION_IDLE_MINUTES="30"
SESSION_MAX_HOURS="12"

# ── E-Mail (empfohlen) ───────────────────────────────────────────
# Ohne SMTP gibt es nur Benachrichtigungen innerhalb von HelferNet; Mails werden dann nur protokolliert.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HelferNet <no-reply@example.org>"

# ── Aufbewahrung (Löschkonzept) ──────────────────────────────────
RETAIN_LEFT_HELPER_MONTHS="24"
RETAIN_AUDIT_MONTHS="36"
RETAIN_NOTIFICATION_DAYS="90"
