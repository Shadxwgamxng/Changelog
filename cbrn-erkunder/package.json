{
  "name": "cbrn-erkunder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "description": "CBRN-Erkunder (Simulation) \u2013 FiveM-Script: Bordcomputer mit NUI-Oberfl\u00e4che und Server-Simulation",
  "scripts": {
    "build": "vite build && node scripts/build-resource.mjs",
    "build:ui": "vite build",
    "build:server": "node scripts/build-resource.mjs",
    "dev": "tsx server/dev.ts",
    "dev:sim": "DEV_SIM=1 tsx server/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "gestis-check": "tsx tools/gestis-index-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}