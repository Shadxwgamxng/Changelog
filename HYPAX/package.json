{
  "name": "hypax",
  "version": "1.0.0",
  "private": true,
  "description": "HYPAX – Verwaltungs- und Organisationssystem für DRK-Gliederungen",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:e2e": "sh scripts/e2e.sh",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && next start"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
