# PostgreSQL
DATABASE_URL="postgresql://hypax:hypax@localhost:5432/hypax?schema=public"

# Öffentliche Basis-URL (für Links in E-Mails/ICS)
APP_URL="http://localhost:3000"

# 32 Byte (Base64) – verschlüsselt Dokumente im Dateispeicher und 2FA-Geheimnisse.
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# Dateispeicher (lokales Verzeichnis; Austausch gegen Object Storage über src/server/storage.ts)
STORAGE_DIR="./storage"

# Geheimnis für den HTTP-Wartungslauf (POST /api/cron/maintenance, Header Authorization: Bearer …)
CRON_SECRET=""

# Sitzungen
SESSION_IDLE_MINUTES="30"
SESSION_MAX_HOURS="12"

# E-Mail (optional – ohne SMTP werden Mails nur protokolliert)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="HYPAX <no-reply@example.org>"

# Web-Push (optional) – Schlüssel: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.org"

# Aufbewahrung (Löschkonzept)
RETAIN_LEFT_HELPER_MONTHS="24"
RETAIN_AUDIT_MONTHS="36"
RETAIN_NOTIFICATION_DAYS="90"
