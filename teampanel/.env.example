# ── Datenbank ───────────────────────────────────────────────
DATABASE_URL="postgresql://panel:panel@localhost:5432/shak_panel?schema=public"

# ── Anwendung ───────────────────────────────────────────────
# Öffentliche Basis-URL (für Einladungs- und Passwort-Reset-Links)
APP_URL="http://localhost:3000"
APP_TIMEZONE="Europe/Berlin"

# ── Sessions / Sicherheit ───────────────────────────────────
# Cookie nur über HTTPS senden. In Produktion hinter HTTPS: true.
# Bei lokalem `npm start` über http://localhost auf false setzen.
AUTH_COOKIE_SECURE="false"
# Sitzungsdauer in Tagen (gleitend verlängert)
SESSION_DAYS="14"

# ── Uploads ─────────────────────────────────────────────────
# Verzeichnis für hochgeladene Bilder (muss beschreibbar sein)
UPLOADS_DIR="./storage/uploads"

# ── E-Mail (optional) ───────────────────────────────────────
# Ohne SMTP_HOST werden E-Mails (z. B. Passwort-Reset-Links) ins Server-Log geschrieben.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SH Airsoft Kommando <panel@example.local>"

# ── Seed / Bootstrap ────────────────────────────────────────
# Passwort der Demo-Accounts (nur für Entwicklung/Test! Nach der Installation ändern)
SEED_DEMO_PASSWORD="DEMO-Passwort-2026!"
# Erster Superadmin für Produktion (npm run db:bootstrap)
INITIAL_SUPERADMIN_EMAIL=""
INITIAL_SUPERADMIN_USERNAME=""
INITIAL_SUPERADMIN_PASSWORD=""
